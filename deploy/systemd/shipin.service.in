[Unit]
Description=shipin 片库服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@INSTALL_DIR@
# long: 网页升级必须管理实际安装的 unit，自定义服务名不能回退到默认服务。
Environment=SHIPIN_SERVICE_NAME=@SERVICE_NAME@
Environment=SHIPIN_SYSTEMD_SCOPE=system
EnvironmentFile=-@INSTALL_DIR@/.env
ExecStart=@INSTALL_DIR@/bin/shipin --listen @LISTEN@ --data-dir @DATA_DIR@ --media-dir @MEDIA_DIR@
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=45s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=@DATA_DIR@ @MEDIA_DIR@

[Install]
WantedBy=multi-user.target
